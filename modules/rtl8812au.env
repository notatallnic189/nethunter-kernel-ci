# rtl8812au (aircrack-ng): monitor mode + injection for external USB adapters.
# Built in "dir" style: make runs inside the module dir with KSRC pointing at
# the kernel out directory.
MODULE_NAME="rtl8812au"
MODULE_REPO="https://github.com/aircrack-ng/rtl8812au.git"
MODULE_REF="734485506a30d6237c2deaad666a19f8ca5379f2"   # default branch head, 2026-11-24
MODULE_STYLE="dir"
MODULE_KO="88XXau.ko"
MODULE_KCFLAGS="-Wno-error=unknown-warning-option"

# Notes: on 4.4 kernels that backported the 4.7+ cfg80211 symbols (the whyred
# NetHunter kernel is one) the CONFIG_KERNEL_HAS_NEW_BANDS fix is required and
# ships as a device patch, see
# devices/whyred-los18.1/patches/driver/rtl8812au-nethunter-whyred.patch.
# The internal sdm660 WiFi (WCN3980) cannot do monitor mode; this module is
# for external RTL8812AU class adapters over USB OTG.
