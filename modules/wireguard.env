# WireGuard (wireguard-linux-compat): VPN module for kernels 3.10 to 5.5 that
# lack in-tree WireGuard. Built in "ksrc" style: make runs inside the kernel
# tree with M=<module dir>/src.
MODULE_NAME="wireguard"
MODULE_REPO="https://github.com/WireGuard/wireguard-linux-compat.git"
MODULE_STYLE="ksrc"
MODULE_M="src"
MODULE_KO="wireguard.ko"
# Skip building this module entirely when the kernel already ships WireGuard
# built-in (CONFIG_WIREGUARD=y): the built-in one loads first, an out-of-tree
# copy would be dead weight in the zip.
MODULE_BUILTIN_CONFIG="CONFIG_WIREGUARD"
MODULE_KCFLAGS="-Wno-error=unknown-warning-option -Wno-gnu-variable-sized-type-not-at-end"

# Notes: wg-quick and the userspace tools are provided by the NetHunter
# chroot or the Android WireGuard app pointing at the kernel module. The
# module must be signed by the same kernel build that loads it, see
# docs/SIGNING.md.
