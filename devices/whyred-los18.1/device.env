# whyred (Redmi Note 5 Pro) on LineageOS 18.1: the reference device.
# This is the live example of the template: the released zips are built from
# exactly these files. Copy this directory to add your own device, see
# docs/ADD-A-DEVICE.md.

DEVICE_TITLE="Redmi Note 5 Pro (whyred), LineageOS 18.1"

# Kernel source (required)
KERNEL_REPO="https://github.com/LineageOS/android_kernel_xiaomi_sdm660.git"
KERNEL_BRANCH="lineage-18.1"

# Defconfig: name of the make target; the file lives next to this env file
# and is copied into arch/arm64/configs/ by the build (required)
DEFCONFIG="whyred-nethunter_defconfig"

# Boot image make target (required). Common values: Image.gz-dtb,
# Image.lz4-dtb, Image.gz, Image
KERNEL_IMAGE="Image.gz-dtb"

# Flashable zip name becomes <ZIP_PREFIX>-<YYYYMMDD>.zip (required)
ZIP_PREFIX="whyred-nethunter-kernel"

# Toolchains (optional; proton-clang is the default for clang, ARMTC_REPO
# adds the arm32 gcc used for CROSS_COMPILE_ARM32)
PROTON_REPO="https://github.com/kdrag0n/proton-clang.git"
ARMTC_REPO="https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9.git"

# Out-of-tree modules to build and sign in the same run (optional).
# Each entry must have a modules/<name>.env file.
DEVICE_MODULES="rtl8812au wireguard"
